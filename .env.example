# ====================================================
# MobAlert Root Environment Configuration
# Copy this file to .env before starting docker-compose
# ====================================================

# Database Configuration
POSTGRES_DB=geowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Backend Spring Boot Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://geo-watch.pages.dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Frontend Configuration (Used during Docker build)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=http://localhost:8080/ws
